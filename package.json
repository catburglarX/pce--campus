{
  "name": "pce-campus-voice",
  "version": "1.0.0",
  "private": true,
  "description": "Private review site for Poornima College of Engineering students: mess food and campus facilities",
  "type": "module",
  "scripts": {
    "start": "bun run src/server.ts",
    "dev": "bun --watch src/server.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "smoke": "bun run scripts/smoke.ts",
    "check": "tsc --noEmit && bun test && bun run scripts/smoke.ts",
    "seed": "bun run src/db/seed.ts",
    "seed:demo": "bun run src/db/seed-demo.ts",
    "reset": "bun run src/db/reset.ts"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "typescript": "5.6.3"
  }
}
